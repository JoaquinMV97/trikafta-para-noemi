---
import type { CollectionEntry } from "astro:content";

interface Props {
  item: CollectionEntry<"comunidad">;
}

const { item } = Astro.props;
const { nombre, tipo, descripcion, redes } = item.data;

const etiquetas ={
    web: "Sitio web",
    facebook: "Facebook",
    instagram: "Instagram",
    tiktok: "TikTok",
    x: "X",
    youtube: "YouTube"
} as const;

const enlaces = (Object.keys(etiquetas) as (keyof typeof etiquetas) [])
    .filter((red) => redes[red])
    .map((red) => ({red, url: redes[red]!, label: etiquetas[red]}));
---

<article class="flex flex-col gap-2 rounded-3xl border-[1.5px] border-line bg-white p-6">
  <span class="self-start rounded-full bg-pop px-3 py-0.5 text-sm font-bold capitalize">{tipo}</span>
  <h3 class="font-display text-xl font-bold">{nombre}</h3>
  <p class="text-muted">{descripcion}</p>
  <ul class="mt-auto flex flex-wrap gap-x-4 gap-y-1 pt-3">
    {enlaces.map(({ url, label }) => (
      <li>
        <a href={url} target="_blank" rel="noopener" class="font-bold text-primary-strong underline-offset-4 hover:underline">
          {label}<span class="sr-only"> de {nombre}</span>
        </a>
      </li>
    ))}
  </ul>
</article>