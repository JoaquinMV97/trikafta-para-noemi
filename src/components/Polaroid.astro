---
import { Image } from "astro:assets";
import type { ImageMetadata } from "astro";

interface Props {
  src: ImageMetadata;
  alt: string;
  caption?: string;
  tilt?: "left" | "right" | "slight";
  eager?: boolean;
  class?: string;
}

const { src, alt, caption, tilt = "slight", eager = false, class: className } = Astro.props;

const tilts = {
    left: "-rotate-6",
    right: "rotate-4",
    slight: "-rotate-2"
};

---

<figure class:list={["border-2 border-ink bg-white p-2 shadow-hard sm:p-3", tilts[tilt], className]}>
  <Image 
    src={src}
    alt={alt}
    widths={[240, 480, 720]}
    sizes="(min-width: 1024px) 260px, 45vw"
    loading={eager ? "eager" : "lazy"}
    fetchpriority={eager ? "high" : "auto"}
    class="aspect-4/5 w-full object-cover"
  />
  {caption && (
    <figcaption class="mt-2 text-center text-sm font-bold">
      {caption}
    </figcaption>
  )}
</figure>