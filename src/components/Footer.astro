---
import { navLinks, socialLinks } from "../data/site";
const year = new Date().getFullYear();
---

<footer class="bg-ink text-on-dark">
  <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-12 px-6 pt-16 pb-8">
    <div class="max-w-sm">
      <p class="font-display text-xl font-extrabold text-white">#TrikaftaParaNoemí</p>
      <p class="mt-3 text-base">¿Tienes alguna pregunta o quieres más información? Escríbeme, estoy aquí para ayudarte.</p>
      <a href="/contacto" class="mt-4 inline-flex min-h-11 items-center rounded-xl bg-white px-5 font-bold text-ink">Escríbeme</a>
    </div>

    <nav aria-label="Secciones" class="flex flex-col gap-2 text-base">
      <p class="mb-1 font-bold text-white">Sitio</p>
      {navLinks.map((link) => <a href={link.href} class="hover:text-white">{link.label}</a>)}
    </nav>

    <nav aria-label="Redes sociales" class="flex flex-col gap-2 text-base">
      <p class="mb-1 font-bold text-white">Sígueme</p>
      {socialLinks.map((s) => (
        <a href={s.href} target="_blank" rel="noopener" class="hover:text-white">{s.label}</a>
      ))}
    </nav>
  </div>

  <div class="mx-auto flex max-w-6xl flex-wrap justify-between gap-3 border-t border-white/15 px-6 py-6 text-sm text-on-dark-muted">
    <span>La información de este sitio es divulgativa y no sustituye la consulta médica.</span>
    <span>© {year} TrikaftaParaNoemí</span>
  </div>
</footer>