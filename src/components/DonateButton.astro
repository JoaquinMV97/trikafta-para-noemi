---
import { GOFUNDME_URL } from "../data/site";

interface Props {
  label?: string;
  size?: "md" | "lg";
  class?: string;
}

const { label = "Apoya a Noemí", size = "md", class: className } = Astro.props;

const sizes = {
  md: "min-h-11 px-5",
  lg: "min-h-14 px-7 text-lg"
}

---


<a
  href={GOFUNDME_URL}
  target="_blank"
  rel="noopener"
  class:list={[
    "inline-flex items-center justify-center gap-2 whitespace-nowrap rounded-2xl border-2 border-ink bg-sun font-bold text-ink shadow-hard transition-transform hover:-translate-x-0.5 hover:-translate-y-0.5",
    sizes[size],
    className,
  ]}
>
  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
    <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1-1.1a5.5 5.5 0 0 0-7.8 7.8l1 1.1L12 21l7.8-7.5 1-1.1a5.5 5.5 0 0 0 0-7.8z" />
  </svg>
  {label}
</a>