---
import { getEntry, render } from "astro:content";
import PaginaLayout from "../layouts/PaginaLayout.astro";
import DonateButton from "../components/DonateButton.astro";
import { tratamiento } from "../data/tratamiento";

const pagina = await getEntry("paginas", "mi-tratamiento");
if (!pagina) throw new Error("Falta src/content/paginas/mi-tratamiento.md");

const { Content } = await render(pagina);
const { titulo, descripcion, eyebrow, actualizado, fuentes } = pagina.data;
---

<PaginaLayout title={titulo} description={descripcion} eyebrow={eyebrow} actualizado={actualizado} fuentes={fuentes}>
  <Content />

  <div slot="despues" class="mt-12 space-y-5">
    {tratamiento.map((bloque) => (
      <section class="rounded-3xl bg-tint-soft p-7">
        <h2 class="font-display text-2xl font-bold">{bloque.area}</h2>
        <p class="mb-4 text-sm text-subtle">{bloque.nota}</p>
        <ul class="grid list-disc gap-x-8 gap-y-1.5 pl-5 sm:grid-cols-2">
          {bloque.items.map((item) => <li>{item}</li>)}
        </ul>
      </section>
    ))}
    <div class="pt-8">
      <DonateButton label="Ayúdame con mi tratamiento" size="lg" />
    </div>
  </div>
</PaginaLayout>