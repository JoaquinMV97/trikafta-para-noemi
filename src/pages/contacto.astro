---
import PaginaLayout from "../layouts/PaginaLayout.astro";
import { CONTACTO, socialLinks } from "../data/site";
---

<PaginaLayout
    title="Contacto"
    description="¿Tienes alguna pregunta o necesitas más información? Escríbeme o encuéntrame en redes sociales."
    eyebrow="Estoy aquí para ayudarte"
>
    <p>
        Si tienes alguna pregunta o necesitas más información sobre la fibrosis
        quística o sobre mi campaña, no dudes en ponerte en contacto conmigo.
    </p>

    <div class="not-prose mt-10 grid gap-5 sm:grid-cols-2">
        <section class="flex flex-col rounded-3xl border-[1.5px] border-line bg-white p-7">
            <h2 class="font-display text-2xl font-bold">Correo electrónico</h2>
            <p class="mt-2 text-muted">
                Escríbeme y te responderé en cuanto pueda.
            </p>
            <div
                data-correo
                data-usuario={CONTACTO.usuario}
                data-dominio={CONTACTO.dominio}
                class="mt-auto pt-6"
            >
                <a
                    data-correo-enlace
                    hidden
                    class="inline-flex min-h-12 items-center gap-2 rounded-2xl bg-primary px-6 font-bold text-white hover:bg-primary-strong"
                >
                    <svg
                        width="20"
                        height="20"
                        viewBox="0 0 24 24"
                        fill="none"
                        stroke="currentColor"
                        stroke-width="2"
                        stroke-linecap="round"
                        stroke-linejoin="round"
                        aria-hidden="true"
                    >
                        <rect x="3" y="5" width="18" height="14" rx="2" />
                        <path d="m3 7 9 6 9-6" />
                    </svg>
                    Escríbeme un correo
                </a>
                <p data-correo-texto class="mt-3 text-sm text-subtle"></p>
                <noscript>
                    <p class="text-sm text-subtle">
                        {CONTACTO.usuario} [arroba] {CONTACTO.dominio}
                    </p>
                </noscript>
            </div>
        </section>

        <section class="rounded-3xl border-[1.5px] border-line bg-white p-7">
            <h2 class="font-display text-2xl font-bold">Redes sociales</h2>
            <p class="mt-2 text-muted">
                Me encuentras como <strong>Trikaftaparanoemi</strong> o{" "}
                <strong>Sonríe en cada respiro</strong>.
            </p>
            <ul class="mt-4 flex flex-wrap gap-2">
                {socialLinks.map((s) => (
                    <li>
                        <a
                            href={s.href}
                            target="_blank"
                            rel="noopener"
                            class="inline-flex min-h-11 items-center rounded-full border-2 border-ink px-4 font-bold hover:bg-tint"
                        >
                            {s.label}
                        </a>
                    </li>
                ))}
            </ul>
        </section>
    </div>
</PaginaLayout>

<script>
  document.querySelectorAll<HTMLElement>("[data-correo]").forEach((bloque) => {
    const { usuario, dominio } = bloque.dataset;
    if (!usuario || !dominio) return;

    const enlace = bloque.querySelector<HTMLAnchorElement>("[data-correo-enlace]");
    const texto = bloque.querySelector<HTMLElement>("[data-correo-texto]");

    if (enlace) {
      enlace.href = `mailto:${usuario}@${dominio}`;
      enlace.hidden = false;
    }
    if (texto) {
      texto.append(`${usuario}@`, document.createElement("wbr"), dominio);
    }
  });
</script>
